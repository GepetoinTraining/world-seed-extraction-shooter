# Copy this to .env at the root of the checkout you play from, and paste your key after the =.
# No quotes. Git ignores .env, so the key stays on this machine.
# The server reads it when it starts, so restart after changing it.
# Never rename it with a VITE_ prefix: that would send the key to every browser.
ANTHROPIC_API_KEY=

# The record, for `npm run pedro` only (D133). From your own Turso database: turso db show --url <name>, turso db tokens create <name>.
# Left blank the game plays on, on this machine only, and says so.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
