{
  "name": "world-seed-genesis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:site": "node --import tsx scripts/build-site.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "pedro": "node --import tsx scripts/pedro.ts",
    "pedro:window": "node --import tsx scripts/pedro.ts --window --built",
    "db:sync": "node --import tsx scripts/pedro.ts --sync-only",
    "serve": "node --import tsx server/main.ts",
    "play": "vite build && node --import tsx server/main.ts",
    "hub": "node --import tsx server/hub/main.ts",
    "hosted": "node --import tsx server/hosted/main.ts",
    "hosted:publish": "node --import tsx scripts/publish-hosted-world.ts",
    "test": "vitest run --exclude \"tests/{database,speed}*\" && vitest run tests/speed && vitest run tests/database",
    "db:generate": "drizzle-kit generate --config=drizzle.config.pg.ts",
    "db:carry": "node --disable-warning=ExperimentalWarning --import tsx scripts/carry-save.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@electric-sql/pglite": "^0.5.14",
    "@libsql/client": "^0.17.4",
    "@mantine/core": "^7.16.0",
    "@mantine/hooks": "^7.16.0",
    "@react-three/drei": "9.108.0",
    "@react-three/fiber": "8.16.8",
    "dexie": "^4.2.1",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "rxdb": "^16.21.0",
    "rxjs": "^7.8.2",
    "three": "0.160.0",
    "tsx": "^4.23.15",
    "uuid": "9.0.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.17",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^24.1.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vitest": "^1.6.0"
  }
}
