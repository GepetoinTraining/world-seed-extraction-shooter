{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist-site",
  "functions": {
    "api/hub.js": { "includeFiles": "drizzle/**", "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/hub/:path*", "destination": "/api/hub?__path=:path*" },
    { "source": "/play/:path*", "destination": "/play/index.html" }
  ],
  "crons": [{ "path": "/api/hub/maintenance", "schedule": "0 7 * * *" }]
}
